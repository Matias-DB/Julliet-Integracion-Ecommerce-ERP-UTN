          <dc:Bounds x="982" y="216" width="55" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="e_f_c1" bpmnElement="f_c1">
        <di:waypoint x="308" y="158" />
        <di:waypoint x="345" y="158" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_f_c2" bpmnElement="f_c2">
        <di:waypoint x="475" y="158" />
        <di:waypoint x="515" y="158" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_f_c3" bpmnElement="f_c3">
        <di:waypoint x="565" y="158" />
        <di:waypoint x="1502" y="158" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_f_c4" bpmnElement="f_c4">
        <di:waypoint x="540" y="183" />
        <di:waypoint x="540" y="230" />

<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="defs" targetNamespace="http://julliet.example/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.31.1">
  <bpmn:collaboration id="collab">
    <bpmn:participant id="pool_cl" name="Cliente (externo)" processRef="proc_cl" />
    <bpmn:participant id="pool_pl" name="Plataforma ecommerce (tercero)" />
    <bpmn:participant id="pool_ju" name="Julliet" processRef="proc_ju" />
    <bpmn:messageFlow id="mf1" name="Orden de compra" sourceRef="c_compra" targetRef="pool_pl" />
    <bpmn:messageFlow id="mf2" name="Orden de compra" sourceRef="pool_pl" targetRef="m_start" />
    <bpmn:messageFlow id="mf3" name="Pedido cancelado" sourceRef="m_cancel" targetRef="pool_pl" />
    <bpmn:messageFlow id="mf4" name="Estado: Preparando" sourceRef="m_prep_ev" targetRef="pool_pl" />
    <bpmn:messageFlow id="mf5" name="Estado: Facturado + factura" sourceRef="m_final" targetRef="pool_pl" />
    <bpmn:messageFlow id="mf6" name="Notificación de factura" sourceRef="pool_pl" targetRef="c_fact" />
    <bpmn:messageFlow id="mf7" name="Aviso de cancelación" sourceRef="pool_pl" targetRef="c_canc" />
  </bpmn:collaboration>
  <bpmn:process id="proc_cl" isExecutable="false">
    <bpmn:startEvent id="c_start" name="El cliente decide comprar">
      <bpmn:outgoing>f_c1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="c_compra" name="Realizar la compra en el ecommerce">
      <bpmn:incoming>f_c1</bpmn:incoming>
      <bpmn:outgoing>f_c2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:eventBasedGateway id="c_gw" name="Espera resultado">
      <bpmn:incoming>f_c2</bpmn:incoming>
      <bpmn:outgoing>f_c3</bpmn:outgoing>
      <bpmn:outgoing>f_c4</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="c_fact" name="Recibe la factura">
      <bpmn:incoming>f_c3</bpmn:incoming>
      <bpmn:outgoing>f_c5</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="c_canc" name="Recibe aviso de cancelación">
      <bpmn:incoming>f_c4</bpmn:incoming>
      <bpmn:outgoing>f_c6</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="c_fin_ok" name="Compra concretada">
      <bpmn:incoming>f_c5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="c_fin_no" name="Compra no concretada">
      <bpmn:incoming>f_c6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_c1" sourceRef="c_start" targetRef="c_compra" />
    <bpmn:sequenceFlow id="f_c2" sourceRef="c_compra" targetRef="c_gw" />
    <bpmn:sequenceFlow id="f_c3" sourceRef="c_gw" targetRef="c_fact" />
    <bpmn:sequenceFlow id="f_c4" sourceRef="c_gw" targetRef="c_canc" />
    <bpmn:sequenceFlow id="f_c5" sourceRef="c_fact" targetRef="c_fin_ok" />
    <bpmn:sequenceFlow id="f_c6" sourceRef="c_canc" targetRef="c_fin_no" />
  </bpmn:process>
  <bpmn:process id="proc_ju" isExecutable="false">
    <bpmn:laneSet id="ls_ju">
      <bpmn:lane id="lane_adm" name="Administración">
        <bpmn:flowNodeRef>a_manual</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_dep" name="Depósito Ecommerce">
        <bpmn:flowNodeRef>d_prep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d_conf</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_mod" name="Módulo de integración (automático)">
        <bpmn:flowNodeRef>m_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_import</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_gdup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_dup_fin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_stock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_gstock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_cancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_cancel_fin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_reserva</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_prep_ev</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_factura</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_gfact</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_final</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_fin</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="m_start" name="Llega la orden del ecommerce">
      <bpmn:outgoing>f_m1</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:serviceTask id="m_import" name="Importar orden y cliente al ERP">
      <bpmn:incoming>f_m1</bpmn:incoming>
      <bpmn:outgoing>f_m2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="m_gdup" name="¿Orden ya importada?">
      <bpmn:incoming>f_m2</bpmn:incoming>
      <bpmn:outgoing>f_m3</bpmn:outgoing>
      <bpmn:outgoing>f_m4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="m_dup_fin" name="Duplicado descartado (queda en el log)">
      <bpmn:incoming>f_m3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="m_stock" name="Validar stock en el depósito ecommerce">
      <bpmn:incoming>f_m4</bpmn:incoming>
      <bpmn:outgoing>f_m5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="m_gstock" name="¿Hay stock disponible?">
      <bpmn:incoming>f_m5</bpmn:incoming>
      <bpmn:outgoing>f_m6</bpmn:outgoing>
      <bpmn:outgoing>f_m7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="m_cancel" name="Cancelar pedido, registrar motivo e informar al ecommerce">
      <bpmn:incoming>f_m6</bpmn:incoming>
      <bpmn:outgoing>f_m8</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="m_cancel_fin" name="Pedido cancelado">
      <bpmn:incoming>f_m8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="m_reserva" name="Reservar stock y generar orden de preparación">
      <bpmn:incoming>f_m7</bpmn:incoming>
      <bpmn:outgoing>f_m9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="m_prep_ev" name="Informa estado «Preparando»">
      <bpmn:incoming>f_m9</bpmn:incoming>
      <bpmn:outgoing>f_d1</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:userTask id="d_prep" name="Preparar el pedido físicamente">
      <bpmn:incoming>f_d1</bpmn:incoming>
      <bpmn:outgoing>f_d2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="d_conf" name="Confirmar la preparación en el sistema">
      <bpmn:incoming>f_d2</bpmn:incoming>
      <bpmn:outgoing>f_m10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="m_factura" name="Emitir factura electrónica automáticamente">
      <bpmn:incoming>f_m10</bpmn:incoming>
      <bpmn:outgoing>f_m11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="m_gfact" name="¿Factura emitida correctamente?">
      <bpmn:incoming>f_m11</bpmn:incoming>
      <bpmn:outgoing>f_m12</bpmn:outgoing>
      <bpmn:outgoing>f_a1</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="a_manual" name="Revisar el error y emitir la factura manualmente">
      <bpmn:incoming>f_a1</bpmn:incoming>
      <bpmn:outgoing>f_a2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="m_final" name="Actualizar estado a «Facturado» y adjuntar comprobante">
      <bpmn:incoming>f_m12</bpmn:incoming>
      <bpmn:incoming>f_a2</bpmn:incoming>
      <bpmn:outgoing>f_m13</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="m_fin" name="Pedido facturado y sincronizado">
      <bpmn:incoming>f_m13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_m1" sourceRef="m_start" targetRef="m_import" />
    <bpmn:sequenceFlow id="f_m2" sourceRef="m_import" targetRef="m_gdup" />
    <bpmn:sequenceFlow id="f_m3" name="Sí" sourceRef="m_gdup" targetRef="m_dup_fin" />
    <bpmn:sequenceFlow id="f_m4" name="No" sourceRef="m_gdup" targetRef="m_stock" />
    <bpmn:sequenceFlow id="f_m5" sourceRef="m_stock" targetRef="m_gstock" />
    <bpmn:sequenceFlow id="f_m6" name="No" sourceRef="m_gstock" targetRef="m_cancel" />
    <bpmn:sequenceFlow id="f_m7" name="Sí" sourceRef="m_gstock" targetRef="m_reserva" />
    <bpmn:sequenceFlow id="f_m8" sourceRef="m_cancel" targetRef="m_cancel_fin" />
    <bpmn:sequenceFlow id="f_m9" sourceRef="m_reserva" targetRef="m_prep_ev" />
    <bpmn:sequenceFlow id="f_d1" sourceRef="m_prep_ev" targetRef="d_prep" />
    <bpmn:sequenceFlow id="f_d2" sourceRef="d_prep" targetRef="d_conf" />
    <bpmn:sequenceFlow id="f_m10" sourceRef="d_conf" targetRef="m_factura" />
    <bpmn:sequenceFlow id="f_m11" sourceRef="m_factura" targetRef="m_gfact" />
    <bpmn:sequenceFlow id="f_m12" name="Sí" sourceRef="m_gfact" targetRef="m_final" />
    <bpmn:sequenceFlow id="f_a1" name="No" sourceRef="m_gfact" targetRef="a_manual" />
    <bpmn:sequenceFlow id="f_a2" sourceRef="a_manual" targetRef="m_final" />
    <bpmn:sequenceFlow id="f_m13" sourceRef="m_final" targetRef="m_fin" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="d1">
    <bpmndi:BPMNPlane id="p1" bpmnElement="collab">
      <bpmndi:BPMNShape id="s_pool_cl" bpmnElement="pool_cl" isHorizontal="true" bioc:stroke="#5b176d" bioc:fill="#e1bee7" color:background-color="#e1bee7" color:border-color="#5b176d">
        <dc:Bounds x="160" y="80" width="1520" height="190" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_c_start" bpmnElement="c_start">

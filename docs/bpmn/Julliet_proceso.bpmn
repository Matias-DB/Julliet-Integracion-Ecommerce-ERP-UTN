      <bpmndi:BPMNShape id="s_m_stock" bpmnElement="m_stock">
        <dc:Bounds x="615" y="580" width="130" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_m_gstock" bpmnElement="m_gstock" isMarkerVisible="true">
        <dc:Bounds x="790" y="600" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="787" y="650" width="56" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_m_cancel" bpmnElement="m_cancel">
        <dc:Bounds x="750" y="470" width="130" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_m_cancel_fin" bpmnElement="m_cancel_fin">
        <dc:Bounds x="932" y="497" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="906" y="533" width="88" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_m_reserva" bpmnElement="m_reserva">
        <dc:Bounds x="865" y="580" width="130" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_m_prep_ev" bpmnElement="m_prep_ev">
        <dc:Bounds x="1022" y="607" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1047" y="496" width="85" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

        <dc:Bounds x="1275" y="925" width="130" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_m_final" bpmnElement="m_final">
        <dc:Bounds x="1415" y="580" width="130" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_m_fin" bpmnElement="m_fin">
        <dc:Bounds x="1592" y="607" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1578" y="656" width="84" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="e_f_m1" bpmnElement="f_m1">
        <di:waypoint x="308" y="625" />
        <di:waypoint x="345" y="625" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_f_m2" bpmnElement="f_m2">
        <di:waypoint x="475" y="625" />
        <di:waypoint x="520" y="625" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_f_m3" bpmnElement="f_m3">
        <di:waypoint x="545" y="600" />
        <di:waypoint x="545" y="533" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="555" y="557" width="11" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_f_m4" bpmnElement="f_m4">
        <di:waypoint x="570" y="625" />
        <di:waypoint x="615" y="625" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="585" y="600" width="15" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_f_m5" bpmnElement="f_m5">
        <di:waypoint x="745" y="625" />
        <di:waypoint x="790" y="625" />

        <dc:Bounds x="975" y="765" width="130" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_d_conf" bpmnElement="d_conf">
        <dc:Bounds x="1145" y="765" width="130" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_m_factura" bpmnElement="m_factura">
        <dc:Bounds x="1145" y="580" width="130" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_m_gfact" bpmnElement="m_gfact" isMarkerVisible="true">
        <dc:Bounds x="1315" y="600" width="50" height="50" />

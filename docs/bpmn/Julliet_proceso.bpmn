          <dc:Bounds x="790" y="178" width="140" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_c_fin_ok" bpmnElement="c_fin_ok">

      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_f_c6" bpmnElement="f_c6">
        <di:waypoint x="878" y="230" />
        <di:waypoint x="942" y="230" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="s_pool_pl" bpmnElement="pool_pl" isHorizontal="true" bioc:stroke="#0d4372" bioc:fill="#bbdefb" color:background-color="#bbdefb" color:border-color="#0d4372">
        <dc:Bounds x="160" y="320" width="1520" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_pool_ju" bpmnElement="pool_ju" isHorizontal="true">
        <dc:Bounds x="160" y="440" width="1520" height="610" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_lane_adm" bpmnElement="lane_adm" isHorizontal="true" bioc:stroke="#6b3c00" bioc:fill="#ffe0b2" color:background-color="#ffe0b2" color:border-color="#6b3c00">
        <dc:Bounds x="190" y="890" width="1490" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_lane_dep" bpmnElement="lane_dep" isHorizontal="true" bioc:stroke="#831311" bioc:fill="#ffcdd2" color:background-color="#ffcdd2" color:border-color="#831311">
        <dc:Bounds x="190" y="730" width="1490" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_lane_mod" bpmnElement="lane_mod" isHorizontal="true" bioc:stroke="#205022" bioc:fill="#c8e6c9" color:background-color="#c8e6c9" color:border-color="#205022">
        <dc:Bounds x="190" y="440" width="1490" height="290" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_m_start" bpmnElement="m_start">
        <dc:Bounds x="272" y="607" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="252" y="643" width="76" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_m_import" bpmnElement="m_import">
        <dc:Bounds x="345" y="580" width="130" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_m_gdup" bpmnElement="m_gdup" isMarkerVisible="true">
        <dc:Bounds x="520" y="600" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="517" y="650" width="56" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_m_dup_fin" bpmnElement="m_dup_fin">
        <dc:Bounds x="527" y="497" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="475" y="461" width="140" height="27" />
        </bpmndi:BPMNLabel>
